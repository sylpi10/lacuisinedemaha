DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS et domaine sans www (aligné sur les canonicals)
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://lacuisinedemaha31.fr%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Fichiers générés par AssetMapper (nom avec hash) : repérés ici pour le
    # cache "1 an" plus bas. Uniquement s'ils existent : une 404 ne doit pas
    # être mise en cache.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^assets/ - [E=HASHED_ASSET:1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

# Cache navigateur des fichiers statiques de public/ (images, uploads, polices).
# Leur nom ne change pas quand leur contenu change : durées modérées.
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"

    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# CSS/JS servis par AssetMapper depuis /assets/ : le hash dans le nom change à
# chaque modification, le navigateur peut donc les garder 1 an sans revérifier.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
    Header unset Expires env=HASHED_ASSET
</IfModule>
