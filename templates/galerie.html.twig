
{% extends 'base.html.twig' %}
{% block title %}Galerie · La cuisine de Maha{% endblock %}
{% block description %}Galerie photos de La cuisine de Maha : brunchs, batch cooking et repas privés préparés par Maha, cheffe à domicile à Pins-Justaret.{% endblock %}
{% block body %}
<section>
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">{{ gallery.galleryName }}</span>
      <h1>{{ gallery.galleryTitle }}</h1>
      <p>
        {{ gallery.description }}
      </p>
    </div>
    <div class="gallery-grid">
      {% for photo in gallery.images %}
      <figure>
        <div class="plate-frame">
          <img src="/uploads/galerie/{{ photo.image }}" alt="Photo de La cuisine de Maha" loading="lazy" width="233" height="233">
        </div>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
