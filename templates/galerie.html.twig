
{% extends 'base.html.twig' %}
{% block title %}Galerie · La cuisine de Maha{% endblock %}
{% block body %}
<section>
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">{{ gallery.galleryName }}</span>
      <h2>{{ gallery.galleryTitle }}</h2>
      <p>
        {{ gallery.description }}
      </p>
    </div>
    <div class="gallery-grid">
      {% for photo in gallery.images %}
      <figure>
        <div class="plate-frame">
          <img src="/uploads/galerie/{{ photo.image }}" alt="Photo de La cuisine de Maha" loading="lazy" width="960" height="1200">
        </div>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
