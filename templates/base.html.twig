<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="google-site-verification" content="LLmRYQior1o9VTi5EB5sedIMjXBz0tCmm6BXXXngOis">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}La cuisine de Maha{% endblock %}</title>
        <meta name="description" content="{% block description %}Maha, cheffe à domicile à Pins-Justaret (31) : brunchs, repas maison et petits événements, cuisinés chez vous ou dans ma cuisine.{% endblock %}">
        {% block robots %}{% endblock %}
        <link rel="preload" as="font" type="font/woff2" href="/fonts/QGYsz_wNahGAdqQ43Rh_fKDp.woff2" crossorigin>
        <link rel="preload" as="font" type="font/woff2" href="/fonts/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxC9TeA.woff2" crossorigin>
        {% block preload %}{% endblock %}
        <link rel="canonical" href="{{ site_url ~ app.request.pathInfo }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="La cuisine de Maha">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:url" content="{{ site_url ~ app.request.pathInfo }}">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:image" content="{{ site_url ~ asset('images/home/profil.webp') }}">
        <meta property="og:image:alt" content="Maha, cheffe à domicile, dans sa cuisine">
        <meta property="og:image:width" content="494">
        <meta property="og:image:height" content="494">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('description') }}">
        <meta name="twitter:image" content="{{ site_url ~ asset('images/home/profil.webp') }}">
        <meta name="twitter:image:alt" content="Maha, cheffe à domicile, dans sa cuisine">
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": ["LocalBusiness", "FoodEstablishment"],
          "@id": "{{ site_url }}/#cheffe",
          "name": "La cuisine de Maha",
          "url": "{{ site_url }}/",
          "image": "{{ site_url ~ asset('images/home/profil.webp') }}",
          "email": "contact@lacuisinedemaha.fr",
          "description": "Cheffe à domicile : brunchs, repas maison et petits événements.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Pins-Justaret",
            "postalCode": "31860",
            "addressCountry": "FR"
          },
          "areaServed": "Pins-Justaret et environs"
        }
        </script>
        <link rel="icon" href="{{ asset('images/brand/favicon.png') }}" type="image/png">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header"><div class="wrap">
          <a class="brand" href="{{ path('site_home') }}"><img class="brand-logo" src="{{ asset('images/brand/logo.webp') }}" alt="" width="42" height="40">La cuisine de <span>Maha</span></a>
          <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">&#9776;</button>
          <nav><ul class="main-nav"><li><a href="{{ path('site_home') }}">Accueil</a></li><li><a href="{{ path('site_formules') }}">Formules &amp; tarifs</a></li><li><a href="{{ path('site_galerie') }}">Galerie</a></li><li><a href="{{ path('site_contact') }}">Contact</a></li></ul></nav>
        </div></header>
        <main>{% block body %}{% endblock %}</main>
        <footer class="site-footer"><div class="wrap"><div class="footer-grid"><div><div class="brand" style="color: var(--ivory);">La cuisine de Maha</div><p style="max-width: 32ch; opacity: .85; margin-top: 10px;">Brunchs, repas maison et petits événements, préparés dans ma cuisine ou dans la vôtre.</p></div><div><dl class="contact-info"><dt>Contact</dt><dd><a href="mailto:contact@lacuisinedemaha.fr">contact@lacuisinedemaha.fr</a></dd></dl></div></div><div class="footer-bottom"><span>&copy; 2026 La cuisine de Maha — Tous droits réservés</span><span>Site conçu et entretenu à la main</span></div></div></footer>
        <script src="{{ asset('js/nav.js') }}"></script>
    </body>
</html>
