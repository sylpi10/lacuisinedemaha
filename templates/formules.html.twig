
{% extends 'base.html.twig' %}
{% block title %}Formules & tarifs · La cuisine de Maha{% endblock %}
{% block description %}Formules et tarifs de La cuisine de Maha : brunchs, repas maison et petits événements à domicile autour de Pins-Justaret (31).{% endblock %}
{% block body %}
<section>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ header.subtitle }}</span>
      <h1>{{ header.title }}</h1>
      <p>{{ header.description }}</p>
    </div>

    <div class="formules-grid">

        {% for key, formula in formulas %}
        <div class="formule-card{% if key == 1 %} is-featured{% endif %}">
          <span class="formule-name">{{ formula.title }}</span>
          <span class="formule-price">{{ formula.price }}</span>
          <ul>
            {% for item in formula.itemList|split("\n") %}
              {% set item = item|trim %}
              {% if item %}
                <li>{{ item }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endfor %}

    </div>
  </div>
</section>

{% if faq %}
<section>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ faq.subtitle }}</span>
      <h2>{{ faq.title }}</h2>
    </div>
    <div style="max-width: 68ch;">
      {% for item in faq.items %}
      <h3>{{ item.question }}</h3>
      <p>{{ item.answer|nl2br }}</p>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
