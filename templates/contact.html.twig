
{% extends 'base.html.twig' %}
{% block title %}Contact · La cuisine de Maha{% endblock %}
{% block body %}
<section>
  <div class="wrap contact-grid">
    <div class="contact-info">
      <span class="eyebrow">Contact</span>
      <h2>Parlons de votre prochain repas</h2>
      <p>
        Pour toute demande, précisez si possible la date envisagée, le
        lieu, la formule souhaitée et le nombre de convives : cela permet
        une première réponse plus rapide.
      </p>
      <dl>
        <dt>E-mail</dt>
        <dd><a href="mailto:contact@lacuisinedemaha.fr">contact@lacuisinedemaha.fr</a></dd>
        <dt>Téléphone</dt>
        <dd><!-- Numéro à compléter --></dd>
        <dt>Zone d'intervention</dt>
        <dd>Pins-Justaret et environs</dd>
      </dl>
    </div>

    {% for message in app.flashes('success') %}
      <p class="form-note" style="font-weight:600;">{{ message }}</p>
    {% endfor %}

    {{ form_start(contactForm, {'attr': {'class': 'contact-form'}}) }}
      <div class="form-row">
        <div>{{ form_row(contactForm.senderName) }}</div>
        <div>{{ form_row(contactForm.senderEmail) }}</div>
      </div>
      <div class="form-row">
        <div>{{ form_row(contactForm.senderPhone) }}</div>
        <div>{{ form_row(contactForm.wishedFormula) }}</div>
      </div>
      <div class="form-row">
        <div>{{ form_row(contactForm.senderDate) }}</div>
        <div>{{ form_row(contactForm.senderWishedNumber) }}</div>
      </div>
      <div>{{ form_row(contactForm.senderMessage) }}</div>
      <p class="form-note">
        <label style="display:flex; align-items:flex-start; gap:8px; font-weight:400;">
          {{ form_widget(contactForm.agreeTerms, {'attr': {'style': 'width:auto;'}}) }}
          {{ contactForm.agreeTerms.vars.label }}
        </label>
        {{ form_errors(contactForm.agreeTerms) }}
      </p>
      <button class="btn btn-primary" type="submit">Envoyer la demande</button>
    {{ form_end(contactForm) }}
  </div>
</section>
{% endblock %}
